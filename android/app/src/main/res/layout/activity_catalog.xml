<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/wl_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card_outlined"
        android:layout_margin="10dp"
        android:padding="6dp">

        <TextView
            android:id="@+id/tv_tab_for_you"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="For You"
            android:gravity="center"
            android:padding="10dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:background="@drawable/bg_tab_pill_selected"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tv_tab_all_apps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="All Apps"
            android:gravity="center"
            android:padding="10dp"
            android:textStyle="bold"
            android:textColor="@color/wl_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="2dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/btn_request_remote_access"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Request Remote Support"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:background="@drawable/bg_button_outline"
            android:textColor="@color/wl_green_light" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_default_apps_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_badge_pill"
        android:backgroundTint="#17231C"
        android:padding="14dp"
        android:layout_margin="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_banner_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/wl_green_light"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_banner_install"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Install"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:background="@drawable/bg_button_primary"
            android:textColor="@color/white" />

    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/wl_background"
        app:tabTextColor="@color/wl_text_secondary"
        app:tabSelectedTextColor="@color/wl_green_light"
        app:tabIndicatorColor="@color/wl_green"
        app:tabIndicatorHeight="3dp"
        app:tabMode="scrollable"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="80dp"
        android:indeterminateTint="@color/wl_green"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="80dp"
        android:textColor="@color/wl_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>

