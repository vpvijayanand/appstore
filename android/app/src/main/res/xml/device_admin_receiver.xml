<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal Device Admin policy: no special uses-policies are required for
     DevicePolicyManager.reboot(), only Device Owner status + this receiver. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
