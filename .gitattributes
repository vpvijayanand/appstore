# Normalize line endings to LF on checkout for all text files
* text=auto eol=lf

# Shell scripts MUST use LF
*.sh text eol=lf

# Windows batch files use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep binaries as-is
*.apk binary
*.aab binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.docx binary
*.pdf binary
*.keystore binary
*.jks binary
*.p12 binary
